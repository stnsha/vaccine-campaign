; Vaccination module secrets. Copy to .env and fill in real values.
; .env is not tracked by git and is denied over HTTP by .htaccess.

; Xilnex sales API credentials (vaccine_invoice.php)
XILNEX_APP_ID=""
XILNEX_TOKEN=""
XILNEX_AUTH="5"
; Full path to the CA bundle for the Xilnex HTTPS call (production value shown)
XILNEX_CA_PATH="C:/xampp/htdocs/odb/xilnex_api/cacert.pem"

; Shared secret for signing Nexus clinic booking links (vaccine_clinic_link.php)
NEXUS_SECRET=""
